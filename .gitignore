# -----------------------------------------------------------------------
# AeroVision – .gitignore
# -----------------------------------------------------------------------

# --- Python caches & compiled files ------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo

# --- Virtual environments ----------------------------------------------
.venv/
venv/
env/
ENV/
.env/

# --- Environment / secrets ---------------------------------------------
.env
.env.*
*.env

# --- Databases ---------------------------------------------------------
*.db
*.sqlite
*.sqlite3

# --- ML model weights (large binary files) -----------------------------
*.pt
*.pth
*.onnx
*.weights

# --- Video / media assets (large files – store in external storage) ----
datasets/videos/*.mp4
datasets/videos/*.avi
datasets/videos/*.mov
datasets/videos/*.mkv
# Keep placeholder text files that document what goes here
!datasets/videos/*.txt
datasets/images/*.jpg
datasets/images/*.jpeg
datasets/images/*.png
!datasets/images/*.txt
src/static/*.mp4
src/static/*.jpg
src/static/*.jpeg
src/static/*.png
!src/static/*.txt

# --- Build / distribution artifacts ------------------------------------
build/
dist/
*.egg-info/
*.egg
MANIFEST

# --- Testing & coverage ------------------------------------------------
.pytest_cache/
.coverage
coverage.xml
htmlcov/
*.log

# --- IDEs & editors ----------------------------------------------------
.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# --- Node (if a JS frontend is added later) ----------------------------
node_modules/
npm-debug.log*

# --- OS generated ------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
